<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background_greeting"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_40dp"
    android:orientation="vertical"
    android:padding="14dp">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:id="@+id/profile_frame"
            android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/bg_profile_circle">
            <ImageView android:id="@+id/profile_image"
                android:layout_width="62dp" android:layout_height="62dp"
                android:layout_gravity="center" android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_toEndOf="@id/profile_frame" android:layout_marginStart="16dp"
            android:layout_centerVertical="true" android:orientation="vertical">
            <TextView android:id="@+id/tv_hello_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colblack" android:textSize="17.05sp"
                android:fontFamily="sans-serif-medium" android:textStyle="normal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Welcome back" android:textColor="@color/white600"
                android:textSize="11.03sp" />
        </LinearLayout>

        <FrameLayout android:layout_width="70.16dp" android:layout_height="70.16dp"
            android:layout_alignParentEnd="true" android:background="@drawable/bg_circle_outline">
            <ImageView android:layout_width="38dp" android:layout_height="38dp"
                android:layout_gravity="center" android:src="@drawable/ic_arrow_up_right"
                android:tint="#8A8A8A" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:orientation="vertical" android:paddingStart="5dp"
        android:paddingEnd="4.03dp">
        <TextView android:id="@+id/tv_date" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white600" android:textSize="12.03sp" />

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colblack"
                android:textSize="40sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/badge_container"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="14dp"
                android:scaleType="fitXY"
                android:src="@drawable/badge_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/badge_icon"
                    android:layout_width="16dp"
                    android:tint="@color/colwhite"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colwhite"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>