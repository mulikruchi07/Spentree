<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgWhite"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Tree"
        android:textAlignment="center"
        android:textColor="@color/colblack"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Tree Image Area -->
    <RelativeLayout
        android:id="@+id/tree_container"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginTop="16dp"
        android:background="#34C759">
        <ImageView
            android:id="@+id/tree_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:scaleType="fitEnd" />
    </RelativeLayout>

    <!-- Expenses Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="@color/inputFill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Expense"
                android:textColor="#999999"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/expense_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0"
                android:textColor="@color/colblack"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Great"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    
    <!-- Limit Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="@color/inputFill"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Limit"
            android:textColor="#999999"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/limit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 0 / 5000"
            android:textColor="@color/colblack"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>